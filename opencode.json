{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "lmstudio"
  ],
  "model": "lmstudio/qwen3.8-27b",
  "small_model": "lmstudio/google/gemma-4-12b-qat",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio local",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 600000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B local",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B local",
          "tool_call": true,
          "reasoning": false,
          "temperature": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "instructions": [
    "Master_Prompt.md"
  ]
}
